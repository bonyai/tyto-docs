{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tyto",
  "colors": {
    "primary": "#c6f24e",
    "light": "#c6f24e",
    "dark": "#9bbf3a"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#08090b"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg",
    "href": "https://tyto.run"
  },
  "redirects": [
    { "source": "/concepts/nests", "destination": "/concepts/sandboxes" },
    { "source": "/concepts/holds", "destination": "/concepts/sandboxes" },
    { "source": "/guides/keepalive-holds", "destination": "/concepts/sandboxes" },
    { "source": "/guides/billing", "destination": "/concepts/organizations" },
    { "source": "/guides/snapshot-and-fork", "destination": "/guides/snapshot-a-sandbox" },
    { "source": "/cli-reference/lifecycle", "destination": "/cli-reference/sandboxes" },
    { "source": "/cli-reference/everyday", "destination": "/cli-reference/sandboxes" },
    { "source": "/cli-reference/data", "destination": "/cli-reference/fs" },
    { "source": "/cli-reference/sessions", "destination": "/cli-reference/session" }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "authentication"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/sandboxes",
              "concepts/templates",
              "concepts/exec",
              "concepts/sessions",
              "concepts/files",
              "concepts/previews",
              "concepts/snapshots",
              "concepts/organizations",
              "concepts/api-keys"
            ]
          },
          {
            "group": "API essentials",
            "pages": ["concepts/errors", "concepts/idempotency", "concepts/websockets"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/run-a-command",
              "guides/transfer-files",
              "guides/expose-a-preview",
              "guides/snapshot-a-sandbox",
              "guides/manage-your-team"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["cli-reference/overview", "cli-reference/configuration"]
          },
          {
            "group": "Getting started",
            "pages": ["cli-reference/login", "cli-reference/console", "cli-reference/create"]
          },
          {
            "group": "Sandboxes",
            "pages": ["cli-reference/sandboxes"]
          },
          {
            "group": "Inside a sandbox",
            "pages": [
              "cli-reference/fs",
              "cli-reference/session",
              "cli-reference/preview",
              "cli-reference/snapshot"
            ]
          },
          {
            "group": "Account",
            "pages": ["cli-reference/org", "cli-reference/account"]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "TypeScript",
            "pages": ["sdks/typescript/installation", "sdks/typescript/usage"]
          },
          {
            "group": "Python",
            "pages": ["sdks/python/installation", "sdks/python/usage"]
          },
          {
            "group": "Go",
            "pages": ["sdks/go/installation", "sdks/go/usage"]
          }
        ]
      },
      {
        "tab": "MCP Server",
        "groups": [
          {
            "group": "MCP Server",
            "pages": ["mcp/overview", "mcp/setup", "mcp/tools"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tyto.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://tyto.run/login"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/bonyai/tyto-docs"
    }
  }
}
